{
  "name": "slova",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "npm run db:prepare-test && playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate-test": "tsx scripts/migrate-test-database.ts",
    "db:seed-test-user": "tsx scripts/seed-test-user.ts",
    "db:prepare-test": "npm run db:migrate-test && npm run db:seed-test-user",
    "budget:status": "tsx scripts/provider-budget-status.ts",
    "account:data": "tsx scripts/account-data.ts",
    "account:whois": "tsx scripts/account-whois.ts",
    "restore:verify": "tsx scripts/verify-restored-database.ts",
    "db:seed-lexicon": "tsx scripts/seed-lexicon.ts",
    "lexicon:build": "tsx scripts/build-lexicon.ts",
    "lexicon:audio": "tsx scripts/build-audio.ts",
    "courses:audio": "tsx scripts/build-course-audio.ts",
    "postinstall": "prisma generate",
    "check:env": "node scripts/check-env.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "vercel:preflight": "npm run check:env && npm test && npm run db:migrate:status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "logrocket": "^12.1.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
