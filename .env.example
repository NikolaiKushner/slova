# Neon connection string for a project created FOR SLOVA — an empty database.
# Pointing this at a database that already holds another app's tables will be
# refused by `prisma migrate deploy` (P3005), which is the intended outcome.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/slova?sslmode=require"

# Direct (non-pooled) URL. Migrations use this when set — DDL through Neon's
# pgbouncer pooler is unreliable. Runtime queries keep using the pooled one.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/slova?sslmode=require"

# Tests use separate names so `npm run test:integration` cannot accidentally
# fall back to the application or production database. Use an isolated Neon
# branch: pooled for application queries, direct for migrations.
TEST_DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/slova_test?sslmode=require"
TEST_DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/slova_test?sslmode=require"
TEST_DATABASE_ENVIRONMENT="test"

# Deterministic credentials used only by the isolated test-user seed and
# Playwright. Use encrypted CI secrets for both values outside local work.
E2E_TEST_USER_EMAIL="learner@slova.test"
E2E_TEST_USER_PASSWORD="replace-with-a-long-test-only-password"

# Production seeding is refused even when the variables above are present.
# Set this only for an explicitly approved smoke-test account, then rotate its
# password after use.
#E2E_ALLOW_PRODUCTION_SEED="true"

# Optional. Playwright starts the local app when this is unset. Set it to an
# already-running local or staging URL to test that deployment instead.
#E2E_BASE_URL="http://localhost:3000"

# openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-in-production-32chars"
AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID="...apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="..."

# resend.com → API Keys. Sends confirmation and password-reset emails.
# Incoming mail on the domain (Cloudflare Email Routing → Gmail) is a
# different thing and does not send. Until the domain is verified, Resend
# only delivers to the address you signed up with, from onboarding@resend.dev.
AUTH_RESEND_KEY="re_..."
AUTH_EMAIL_FROM="Slova <hello@slova.study>"

# console.anthropic.com → API keys. Required: batch translation is the only
# thing that turns a pasted list into a set without 40 round-trips.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional. Defaults to claude-haiku-4-5 — cheapest and fastest of the family,
# and translating dictionary pairs asks nothing more of a model. Changing this
# is safe: lib/llm/models.ts only sends parameters the named model accepts.
#LLM_MODEL=claude-haiku-4-5

# Optional daily ceiling per user, defaults in lib/llm/budget.ts. Sized from a
# measurement: one 40-word list costs ~$0.004, so 50 requests is ~$0.20 a day
# per person. Anyone with a Google account can sign in, so this and the
# global ceiling below are what stand between an open door and a bill.
#LLM_DAILY_REQUESTS=50
#LLM_DAILY_INPUT_TOKENS=100000
#LLM_DAILY_OUTPUT_TOKENS=60000
# A second, app-wide UTC-day ceiling shared by every account. Defaults to one
# personal allowance, so creating more accounts cannot multiply the bill.
#LLM_GLOBAL_DAILY_REQUESTS=50
#LLM_GLOBAL_DAILY_INPUT_TOKENS=100000
#LLM_GLOBAL_DAILY_OUTPUT_TOKENS=60000

# Disabled by default. When true, an authenticated request for one short text
# may synthesize a missing pronunciation after the shared Lexeme cache and
# daily budget have both been checked. Never expose provider keys as
# NEXT_PUBLIC_* variables.
TTS_ON_DEMAND_ENABLED="false"
#TTS_DAILY_REQUESTS=20
#TTS_DAILY_CHARACTERS=2000
# A second, app-wide UTC-day ceiling shared by every account. It is reserved
# atomically before provider work and defaults conservatively to 100 requests /
# 10,000 characters, so creating more accounts cannot multiply the bill.
#TTS_GLOBAL_DAILY_REQUESTS=100
#TTS_GLOBAL_DAILY_CHARACTERS=10000

# platform.openai.com → API keys. Pays for `tts-1`, which is per-character and
# costs about $0.15 for the whole 8k-word lexicon. Required by deploy preflight
# only when TTS_ON_DEMAND_ENABLED=true; also used by `npm run lexicon:audio`.
#OPENAI_API_KEY="sk-proj-..."

# Cloudflare → R2. Free to 10GB with no egress charge, which is why the audio
# lives here rather than on Vercel Blob. The bucket must have public access
# enabled separately from the token — a valid token is not enough for anyone
# to hear the files.
# Required at runtime only when on-demand TTS is enabled. The audio build
# scripts also use these variables when run manually.
#R2_ACCOUNT_ID="..."
#R2_ACCESS_KEY_ID="..."
#R2_SECRET_ACCESS_KEY="..."
#R2_BUCKET="slova-audio"

# The bucket's public base URL, and the reason the script refuses to start
# without it: without somewhere to put the files, every recording is paid for
# and thrown away. That has happened once.
#R2_PUBLIC_URL="https://pub-....r2.dev"
