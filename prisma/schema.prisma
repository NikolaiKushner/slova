generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String?
  image         String?
  // Sign-in is Google-only; no local passwords are stored.
  dailyNewLimit Int     @default(20)

  createdAt DateTime @default(now())

  words UserWord[]
  sets  WordSet[]
}

/// A word as this user keeps it: their spelling, their translation, their
/// progress. One row per word per user, however many sets it belongs to —
/// which is the whole point of splitting sets out into WordSetItem.
model UserWord {
  id     String @id @default(cuid())
  userId String

  /// normalizeKey(front). The dedup key: importing a word already present
  /// updates that row instead of creating a second one with its own schedule.
  key   String
  front String
  back  String

  note    String?
  example String?
  /// Where it came from — a column heading off a pasted lesson, a catalog set.
  source  String?

  /// Link into the shared base, deliberately without a foreign key. Nothing in
  /// Postgres ties user data to the lexicon, so the lexicon can be dumped,
  /// rebuilt, or moved to its own project without touching anything here.
  /// Integrity is lib/lexicon's job.
  lexemeId String?

  dueAt        DateTime  @default(now())
  /// Days the scheduler chose to wait. Written from FSRS's scheduled_days and
  /// kept as a column because the list sorts and the learned rating read it —
  /// both want one number, monotone in how well the word is known.
  intervalDays Float     @default(0)
  /// Legacy from the interval-doubling scheduler that came before FSRS.
  /// Nothing reads it any more; kept so this migration stays additive.
  ease         Float     @default(2.5)
  introducedAt DateTime?

  /// FSRS memory state. Three numbers instead of one ease factor: how long the
  /// memory currently lasts, how hard this particular word is for this person,
  /// and where it is in the learning cycle. Null until the first review — a
  /// word nobody has studied has no memory to model.
  stability     Float?
  difficulty    Float?
  /// State enum from ts-fsrs: 0 new, 1 learning, 2 review, 3 relearning.
  srsState      Int       @default(0)
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  /// Times this word was forgotten after having been learned. FSRS treats a
  /// lapse very differently from a first failure, which is most of why it
  /// beats a fixed multiplier.
  lapses        Int       @default(0)
  lastReviewAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets    WordSetItem[]
  reviews ReviewLog[]

  @@unique([userId, key])
  @@index([userId, dueAt])
  @@index([userId, introducedAt])
  @@index([lexemeId])
}

/// A named group of words. Closer to a tag than a folder: removing a word from
/// a set does not delete the word.
model WordSet {
  id     String @id @default(cuid())
  userId String
  title  String

  // What the set translates between; seeds auto-translate and, later, speech.
  sourceLang String @default("en")
  targetLang String @default("ru")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WordSetItem[]

  @@index([userId])
}

model WordSetItem {
  wordId  String
  setId   String
  addedAt DateTime @default(now())

  word UserWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  set  WordSet  @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([wordId, setId])
  @@index([setId])
}

model ReviewLog {
  id        String   @id @default(cuid())
  wordId    String
  rating    String
  createdAt DateTime @default(now())

  word UserWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  // Word state just before this rating, so a misclick can be taken back.
  prevIntervalDays Float?
  prevEase         Float?
  prevDueAt        DateTime?
  prevIntroducedAt DateTime?

  /// The whole scheduler state before this rating, as FSRS keeps it. One
  /// column rather than six more: undo needs to put back exactly what was
  /// there, and the shape of that is the scheduler's business, not the
  /// database's. Null on rows written before FSRS.
  prevCard Json?

  @@index([wordId])
  @@index([wordId, createdAt])
}

/// What one user spent, and got, in one UTC day.
///
/// Two jobs in one row. The counters on the left are a spending cap: sign-in is
/// Google-only with no allow-list, so anyone with a Google account can reach
/// the translate route, and without a ceiling the first bored visitor spends
/// our key. The counters on the right are the only measurement that says
/// whether the shared base is working at all — hits divided by hits plus
/// misses. Both are per user per day, so both fit the same row.
///
/// No foreign key to User, deliberately: this table is disposable. Dropping it
/// costs a migration and nothing else, and rows for a deleted account are dead
/// weight rather than a broken reference.
model LlmUsage {
  id     String @id @default(cuid())
  userId String
  /// The UTC calendar day as YYYY-MM-DD. A string, not a DateTime, because the
  /// only question ever asked of it is "same day?" — and a date with a time on
  /// it answers that wrongly at every boundary.
  day    String

  requests     Int @default(0)
  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// Words answered from the lexicon, and words that had to go to the model.
  lexiconHits Int @default(0)
  llmMisses   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

/// The shared base, one row per distinct word or phrase. A cache in front of
/// the translator — never the authority. A user editing their own translation
/// changes their UserWord and nothing here.
model Lexeme {
  id   String @id @default(cuid())
  lang String
  /// normalizeKey(text) — what lookups match on.
  key  String
  text String
  /// "word" | "phrase"
  kind String @default("word")

  /// "seed" | "llm" | "import" | "curated". Kept on the lexeme as well as on
  /// each translation so a seeding run can be re-applied or rolled back
  /// without disturbing what real use has accumulated.
  source String

  transcription String?
  partOfSpeech  String?

  imageUrl    String?
  imageSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations LexemeTranslation[]

  @@unique([lang, key])
  @@index([source])
}

model LexemeTranslation {
  id         String @id @default(cuid())
  lexemeId   String
  targetLang String
  text       String

  /// "seed" | "llm" | "import" | "curated" — also the precedence order for
  /// picking the primary, curated highest.
  source String
  /// Which model produced it, when source is "llm".
  model  String?
  /// Bumped in code to retire a generation: older rows stop counting as a hit
  /// and get re-asked for, without deleting anything.
  version Int @default(1)

  /// How many independent sources produced exactly this text. A translation a
  /// person typed starts at 0 and stays private to them until something else
  /// agrees, so one bad paste cannot spread.
  confirmations Int     @default(0)
  isGlobal      Boolean @default(false)
  isPrimary     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lexeme Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([lexemeId, targetLang, text])
  @@index([lexemeId, targetLang, isGlobal, isPrimary])
}
