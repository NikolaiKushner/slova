generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  /// Set when they confirm a registration email, reset a password, or sign
  /// in with Google. Null on older Google-only rows is fine: Google still
  /// lets them in; email-and-password waits for a confirmed address.
  emailVerified DateTime?
  /// scrypt hash (`salt:hash` hex). Null when they only ever used Google.
  passwordHash  String?
  dailyNewLimit Int       @default(20)
  /// Bumped on password reset so JWTs issued before that moment die.
  sessionVersion Int      @default(0)

  createdAt DateTime @default(now())

  accounts       Account[]
  words          UserWord[]
  sets           WordSet[]
  courses        UserCourse[]
  sittings       StudySitting[]
  reviewLogs     ReviewLog[]
  stories        StoryProgress[]
  grammarRules   GrammarRuleMemory[]
  grammarReviews GrammarRuleReviewLog[]
  texts          UserText[]
}

/// A login method attached to a User. Google stores the OAuth tokens here;
/// email-and-password does not write a row (Auth.js only links OAuth).
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

/// One-time hashed token for email confirm and password-reset links.
/// `identifier` is `verify:email` or `reset:email`. Deleted when used.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@unique([identifier])
  @@index([expires])
}

/// A word as this user keeps it: their spelling, their translation, their
/// progress. One row per word per user, however many sets it belongs to —
/// which is the whole point of splitting sets out into WordSetItem.
model UserWord {
  id     String @id @default(cuid())
  userId String

  /// normalizeKey(front). The dedup key: importing a word already present
  /// updates that row instead of creating a second one with its own schedule.
  key   String
  front String
  back  String

  note    String?
  example String?
  /// Where it came from — a column heading off a pasted lesson, a catalog set.
  source  String?

  /// Link into the shared base, deliberately without a foreign key. Nothing in
  /// Postgres ties user data to the lexicon, so the lexicon can be dumped,
  /// rebuilt, or moved to its own project without touching anything here.
  /// Integrity is lib/lexicon's job.
  lexemeId String?

  dueAt        DateTime  @default(now())
  /// Days the scheduler chose to wait. Written from FSRS's scheduled_days and
  /// kept as a column because the list sorts and the learned rating read it —
  /// both want one number, monotone in how well the word is known.
  intervalDays Float     @default(0)
  /// Legacy from the interval-doubling scheduler that came before FSRS.
  /// Nothing reads it any more; kept so this migration stays additive.
  ease         Float     @default(2.5)
  introducedAt DateTime?

  /// FSRS memory state. Three numbers instead of one ease factor: how long the
  /// memory currently lasts, how hard this particular word is for this person,
  /// and where it is in the learning cycle. Null until the first review — a
  /// word nobody has studied has no memory to model.
  stability     Float?
  difficulty    Float?
  /// State enum from ts-fsrs: 0 new, 1 learning, 2 review, 3 relearning.
  srsState      Int       @default(0)
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  /// Times this word was forgotten after having been learned. FSRS treats a
  /// lapse very differently from a first failure, which is most of why it
  /// beats a fixed multiplier.
  lapses        Int       @default(0)
  lastReviewAt  DateTime?

  /// Optimistic concurrency token for scheduler mutations. Every review,
  /// graduation, and undo advances it; a stale writer cannot overwrite a
  /// state calculated by another request.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets    WordSetItem[]
  reviews ReviewLog[]

  @@unique([userId, key])
  @@index([userId, dueAt])
  @@index([userId, introducedAt])
  @@index([lexemeId])
}

/// A named group of words. Closer to a tag than a folder: removing a word from
/// a set does not delete the word.
model WordSet {
  id     String @id @default(cuid())
  userId String
  title  String

  // What the set translates between; seeds auto-translate and, later, speech.
  sourceLang String @default("en")
  targetLang String @default("ru")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WordSetItem[]

  @@index([userId])
}

model WordSetItem {
  wordId  String
  setId   String
  addedAt DateTime @default(now())

  word UserWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  set  WordSet  @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([wordId, setId])
  @@index([setId])
}

model ReviewLog {
  id        String   @id @default(cuid())
  /// Client-generated mutation id. Nullable only for rows created before the
  /// idempotent review API; every new review and graduation supplies one.
  operationId String? @unique
  /// Monotonic UserWord version produced by this operation. It orders reviews
  /// exactly even when two rows share a timestamp, and remains stable if a
  /// later operation is undone.
  wordVersion Int?
  wordId    String
  /// Copied from the word so progress can count days without joining UserWord.
  /// Backfilled on existing rows; new writes set it.
  userId    String
  sittingId String?
  rating    String
  createdAt DateTime @default(now())
  /// Undo is a tombstone, not a delete: a delayed retry of the original
  /// operation must stay a no-op. Activity queries exclude tombstoned rows.
  undoneAt DateTime?

  /// ExerciseKind, or "study" / "graduate". Null on rows from before sittings.
  kind String?
  /// "correct" | "almost" | "wrong". Null on study cards and on old rows.
  verdict String?
  /// Show → answer, clamped 1..120000. Tea between cards is not a review.
  elapsedMs Int?
  /// Interval the scheduler chose after this rating; prev already lives above.
  nextIntervalDays Float?
  /// Brainstorm only: misses on the ladder. Null everywhere else.
  errors Int?

  word    UserWord      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sitting StudySitting? @relation(fields: [sittingId], references: [id], onDelete: SetNull)

  // Word state just before this rating, so a misclick can be taken back.
  prevIntervalDays Float?
  prevEase         Float?
  prevDueAt        DateTime?
  prevIntroducedAt DateTime?

  /// The whole scheduler state before this rating, as FSRS keeps it. One
  /// column rather than six more: undo needs to put back exactly what was
  /// there, and the shape of that is the scheduler's business, not the
  /// database's. Null on rows written before FSRS.
  prevCard Json?

  @@index([wordId])
  @@index([wordId, createdAt])
  @@unique([wordId, wordVersion])
  @@index([userId, createdAt])
  @@index([sittingId])
}

/// One visit to a training or a lesson — not one review. Hours, weekly bars
/// and "practice vs grammar" will sum these; until then they just accumulate.
model StudySitting {
  id     String @id @default(cuid())
  userId String

  /// "practice" | "brainstorm" | "study" | "grammar"
  kind String
  /// Format slug, or "courseSlug/lessonSlug" for a lesson.
  label String

  /// "due" | "new" | "hard" | "all" — the filter at the start, not what they did.
  sourceState String
  setIds      String[] @default([])

  dueAtStart Int @default(0)
  newAtStart Int @default(0)

  startedAt DateTime
  lastAt    DateTime
  endedAt   DateTime?

  /// "completed" | "abandoned". Null while the tab is still open.
  endedReason String?

  /// lastAt − startedAt. The summary screen and a pause after the last
  /// answer do not count; a sitting stale for 3 hours closes at lastAt.
  durationSec Int @default(0)
  reviews     Int @default(0)
  goods       Int @default(0)
  agains      Int @default(0)
  introduced  Int @default(0)

  /// Lesson percent; null on word sittings.
  score         Int?
  /// Missed rules of this attempt, not the accumulated UserLesson list.
  missedRuleIds String[] @default([])

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs           ReviewLog[]
  grammarReviews GrammarRuleReviewLog[]

  @@index([userId, startedAt])
}

/// What one user spent, and got, in one UTC day.
///
/// Two jobs in one row. The counters on the left are a spending cap: sign-in is
/// open (Google or email and password) with no allow-list, so anyone who can
/// complete it can reach the translate route, and without a ceiling the first
/// bored visitor spends our key. The counters on the right are the only
/// measurement that says
/// whether the shared base is working at all — hits divided by hits plus
/// misses. Both are per user per day, so both fit the same row.
///
/// No foreign key to User, deliberately: this table is disposable. Dropping it
/// costs a migration and nothing else, and rows for a deleted account are dead
/// weight rather than a broken reference.
model LlmUsage {
  id     String @id @default(cuid())
  userId String
  /// The UTC calendar day as YYYY-MM-DD. A string, not a DateTime, because the
  /// only question ever asked of it is "same day?" — and a date with a time on
  /// it answers that wrongly at every boundary.
  day    String

  requests     Int @default(0)
  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// Words answered from the lexicon, and words that had to go to the model.
  lexiconHits Int @default(0)
  llmMisses   Int @default(0)

  /// Durable alert state. A denied reservation updates this row so an operator
  /// can see exhausted caps without searching short-lived runtime logs.
  capReachedAt DateTime?
  capReason    String?
  capAttempts  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

/// On-demand pronunciation spend and cache effectiveness for one UTC day.
/// Reservations are never refunded: a failed provider or upload attempt still
/// consumed a paid-path slot and cannot be retried without bound.
model TtsUsage {
  id     String @id @default(cuid())
  userId String
  day    String

  requests   Int @default(0)
  characters Int @default(0)
  cacheHits  Int @default(0)
  syntheses  Int @default(0)

  /// Failed reservations are kept as durable operational alerts.
  capReachedAt DateTime?
  capReason    String?
  capAttempts  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

/// The shared base, one row per distinct word or phrase. A cache in front of
/// the translator — never the authority. A user editing their own translation
/// changes their UserWord and nothing here.
model Lexeme {
  id   String @id @default(cuid())
  lang String
  /// normalizeKey(text) — what lookups match on.
  key  String
  text String
  /// "word" | "phrase"
  kind String @default("word")

  /// "seed" | "llm" | "import" | "curated". Kept on the lexeme as well as on
  /// each translation so a seeding run can be re-applied or rolled back
  /// without disturbing what real use has accumulated.
  source String

  transcription String?
  partOfSpeech  String?
  /// Irregular verb forms, shared like the translation. Null on everything
  /// else. Shape: `{ past, participle }` plus optional `acceptPast` for the
  /// one verb that has two (`be` → was / were).
  forms Json?

  imageUrl    String?
  imageSource String?

  /// Recorded pronunciation, shared by everyone the way the translation is —
  /// paid for once per word rather than once per learner. Null means the
  /// browser's own voice says it instead, which it can do for any word.
  audioUrl    String?
  /// Purpose-made slower pronunciation. Null falls back to slowing audioUrl.
  audioSlowUrl String?
  /// Which voice made it, so a generation can be replaced without guessing.
  audioSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations LexemeTranslation[]

  @@unique([lang, key])
  @@index([source])
}

model LexemeTranslation {
  id         String @id @default(cuid())
  lexemeId   String
  targetLang String
  text       String

  /// "seed" | "llm" | "import" | "curated" — also the precedence order for
  /// picking the primary, curated highest.
  source String
  /// Which model produced it, when source is "llm".
  model  String?
  /// Bumped in code to retire a generation: older rows stop counting as a hit
  /// and get re-asked for, without deleting anything.
  version Int @default(1)

  /// How many distinct users (or a seed/curated write) produced exactly this
  /// text. A typed or model translation stays private until a second person
  /// agrees, so one paste or one prompt-injection cannot become everyone's
  /// answer.
  confirmations Int     @default(0)
  isGlobal      Boolean @default(false)
  /// Enforced by a partial unique index from the lexicon-correctness migration:
  /// at most one true row per (lexemeId, targetLang).
  isPrimary     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lexeme        Lexeme                            @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  confirmationsBy LexemeTranslationConfirmation[]

  @@unique([lexemeId, targetLang, text])
  @@index([lexemeId, targetLang, isGlobal, isPrimary])
}

/// One person agreeing with one translation. The unique pair is what stops
/// the same account confirming twice and publishing a private wording.
model LexemeTranslationConfirmation {
  translationId String
  userId        String
  createdAt     DateTime @default(now())

  translation LexemeTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@id([translationId, userId])
  @@index([userId])
}

/// Fixed-window counters for login, mail and write bursts. Lives in Postgres
/// so serverless isolates share the same ceiling.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '24:00:00'::interval)"))

  @@index([expiresAt])
}

/// A person's place in one grammar course. The course itself is a folder of
/// JSON; this row is only where they stopped, and whether they finished.
model UserCourse {
  id             String    @id @default(cuid())
  userId         String
  courseSlug     String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  lastLessonSlug String?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons UserLesson[]

  @@unique([userId, courseSlug])
  @@index([userId])
}

/// One lesson attempt history. `score` is the latest run; `bestScore` is what
/// unlocking uses, so a worse retry cannot take a pass away.
model UserLesson {
  id            String    @id @default(cuid())
  userId        String
  courseSlug    String
  lessonSlug    String
  /// "in_progress" | "completed"
  status        String    @default("in_progress")
  score         Int       @default(0)
  bestScore     Int       @default(0)
  attempts      Int       @default(0)
  missedRuleIds String[]  @default([])
  completedAt   DateTime?

  course      UserCourse      @relation(fields: [userId, courseSlug], references: [userId, courseSlug], onDelete: Cascade)
  attemptLogs LessonAttempt[]

  @@unique([userId, courseSlug, lessonSlug])
  @@index([userId])
}

/// One submitted lesson result. The aggregate remains on UserLesson; this
/// narrow ledger gives retries an idempotency boundary and preserves the
/// client-supplied result that changed it.
model LessonAttempt {
  id            String   @id @default(cuid())
  operationId   String   @unique
  userId        String
  courseSlug    String
  lessonSlug    String
  score         Int
  missedRuleIds String[] @default([])
  createdAt     DateTime @default(now())

  lesson UserLesson @relation(fields: [userId, courseSlug, lessonSlug], references: [userId, courseSlug, lessonSlug], onDelete: Cascade)

  @@index([userId, courseSlug, lessonSlug])
}

/// A learner's place in one story — docs/plans/shipped/stories.md §5.4. Content
/// lives in the repository, not here: this row references a story by slug
/// with no foreign key, the same deliberate looseness `UserWord.lexemeId`
/// has, so content can move without touching a single progress row.
model StoryProgress {
  id           String    @id @default(cuid())
  userId       String
  storySlug    String
  /// Keyed by question id: { "q-main": { answer, correct, answeredAt } }
  answers      Json
  correctCount Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storySlug])
  @@index([userId, completedAt])
}

/// A grammar rule this learner got wrong, and where it is in coming back.
///
/// Rule-level, not exercise-level: a miss schedules the point, and Grammar
/// Review asks a fresh `bank.json` prompt for it — never the sentence just
/// seen. `courseSlug` and `ruleId` reference repository content with no
/// foreign key, the same deliberate looseness StoryProgress has: content can
/// be renamed or dropped and the queue simply skips the row.
model GrammarRuleMemory {
  id         String @id @default(cuid())
  userId     String
  courseSlug String
  ruleId     String

  /// Consecutive successful review appearances since the latest miss: 0..3.
  stage Int @default(0)
  /// Null only after stage 3 clears the rule for now. A later miss reopens it.
  dueAt DateTime?

  lastMissedAt   DateTime
  lastReviewedAt DateTime?
  clearedAt      DateTime?
  /// So the next return prefers a prompt other than the one just answered.
  lastExerciseId String?

  reps    Int @default(0)
  lapses  Int @default(0)
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs GrammarRuleReviewLog[]

  @@unique([userId, courseSlug, ruleId])
  @@index([userId, dueAt])
  @@index([userId, lastMissedAt])
}

/// One answered Grammar Review prompt.
///
/// Not analytics: it makes a retry idempotent, stops two tabs from advancing
/// the same due rule twice, and keeps enough of the previous state to explain
/// a schedule that feels wrong. There is no undo here, so the old values are
/// scalar columns rather than a JSON snapshot.
model GrammarRuleReviewLog {
  id          String  @id @default(cuid())
  operationId String  @unique
  memoryId    String
  userId      String
  sittingId   String?

  courseSlug String
  ruleId     String
  exerciseId String
  correct    Boolean
  elapsedMs  Int?

  /// False means another request had already moved this rule out of the due
  /// queue. Recording the no-op makes retries idempotent.
  applied Boolean @default(true)

  /// GrammarRuleMemory version this write produced; null for a stale no-op,
  /// which produced none. Orders reviews exactly, as ReviewLog.wordVersion does.
  ruleVersion   Int?
  previousStage Int?
  /// Resulting stage for an applied write, or the observed current stage for
  /// a stale no-op. Kept non-null so an idempotent retry returns the same DTO.
  nextStage     Int
  previousDueAt DateTime?
  nextDueAt     DateTime?

  createdAt DateTime @default(now())

  memory  GrammarRuleMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sitting StudySitting?     @relation(fields: [sittingId], references: [id], onDelete: SetNull)

  @@unique([memoryId, ruleVersion])
  @@index([userId, createdAt])
  @@index([sittingId])
}

/// A text this person pasted, read through a tokenization that is recomputed
/// on open rather than stored — docs/plans/reader.md §5.1.
model UserText {
  id     String @id @default(cuid())
  userId String

  title String
  body  String

  /// Contextual glosses the reader asked for, by token id. The one thing here
  /// `body` cannot rebuild: tokenizing a text at the 20 000-character cap
  /// takes 10 ms, against 226 KB of JSON to store its output.
  glosses Json @default("{}")

  wordCount Int
  charCount Int

  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}
